{
  "name": "Don't Drop The Egg!",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "EggRaceMatchmaking": {
        "$className": "Folder",
        "MatchProtocol": {
          "$path": "src/ReplicatedStorage/EggRaceMatchmaking/MatchProtocol.luau"
        },
        "MatchAdmission": {
          "$path": "src/ReplicatedStorage/EggRaceMatchmaking/MatchAdmission.luau"
        },
        "MatchmakingClient": {
          "$path": "src/ReplicatedStorage/EggRaceMatchmaking/MatchmakingClient.luau"
        }
      },
      "EggRaceMath": {
        "$className": "Folder",
        "CameraFit": {
          "$path": "src/ReplicatedStorage/EggRaceMath/CameraFit.luau"
        }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "$path": "src/ServerScriptService"
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterCharacterScripts": {
        "$className": "StarterCharacterScripts",
        "$ignoreUnknownInstances": true,
        "$path": "src/StarterCharacterScripts"
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "$path": "src/StarterPlayerScripts"
      },
      "$properties": {
        "CameraMaxZoomDistance": 128.0,
        "CharacterBreakJointsOnDeath": false,
        "CharacterJumpPower": 12.0,
        "CharacterUseJumpPower": true
      },
      "$ignoreUnknownInstances": true
    }
  },
  "emitLegacyScripts": true,
  "syncbackRules": {
    "syncCurrentCamera": false,
    "syncUnscriptable": false,
    "ignoreReferents": false
  }
}
