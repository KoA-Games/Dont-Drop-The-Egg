local function addPose(keyframe: Keyframe, name: string, values: { number }, style: Enum.PoseEasingStyle, direction: Enum.PoseEasingDirection): Pose
	local pose = Instance.new("Pose")
	pose.Name = name
	pose.CFrame = CFrame.new(table.unpack(values))
	pose.Weight = 1
	pose.EasingStyle = style
	pose.EasingDirection = direction
	pose.Parent = keyframe
	return pose
end

return function(): KeyframeSequence
	local sequence = Instance.new("KeyframeSequence")
	sequence.Name = "FallBackLeft_LocalPreview"
	sequence.Loop = false
	sequence.Priority = Enum.AnimationPriority.Action4

	for _, frameData in FRAMES do
		local keyframe = Instance.new("Keyframe")
		keyframe.Name = frameData.name
		keyframe.Time = frameData.time
		local style = Enum.PoseEasingStyle[frameData.style]
		local direction = Enum.PoseEasingDirection[frameData.direction]
		local poses: { [string]: Pose } = {}
		for poseName, values in frameData.poses do
			poses[poseName] = addPose(keyframe, poseName, values, style, direction)
		end
		for poseName, parentName in PARENTS do
			if poses[poseName] and poses[parentName] then
				poses[poseName].Parent = poses[parentName]
			end
		end
		if frameData.marker then
			local marker = Instance.new("KeyframeMarker")
			marker.Name = frameData.marker
			marker.Parent = keyframe
		end
		keyframe.Parent = sequence
	end

	return sequence
end
