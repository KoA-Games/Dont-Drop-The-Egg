{
  "name": "DontDropTheEggSyncback",
  "tree": {
    "$className": "DataModel",
    "ReplicatedFirst": {
      "$className": "ReplicatedFirst",
      "$path": "syncback-src/ReplicatedFirst"
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$path": "syncback-src/ReplicatedStorage"
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "syncback-src/ServerScriptService"
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "$path": "syncback-src/ServerStorage"
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$properties": {
        "ScreenOrientation": "Sensor"
      },
      "$path": "syncback-src/StarterGui"
    },
    "StarterPack": {
      "$className": "StarterPack",
      "$path": "syncback-src/StarterPack"
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "AvatarJointUpgrade": "Enabled",
        "CameraMaxZoomDistance": 128.0,
        "CharacterBreakJointsOnDeath": false,
        "CharacterJumpPower": 12.0
      },
      "$path": "syncback-src/StarterPlayer"
    },
    "TestService": {
      "$className": "TestService",
      "$path": "syncback-src/TestService"
    }
  },
  "syncbackRules": {
    "syncCurrentCamera": false,
    "syncUnscriptable": true,
    "ignoreReferents": false
  }
}